# Private inputs and local execution evidence (never published)
# datasets/ holds data that is not redistributed; results/ holds run artifacts.
# Dataset specifications live in docs/DATASETS.md, which is tracked.
/datasets/
/results/

# 可运行包：datasets 是目录联接，git 会跟进去，必须显式排除，
# 否则 SMD 的 .txt 与各 meta.json 会被加进版本库。
/deliverables/06-可运行包/datasets/
/deliverables/06-可运行包/_运行输出/
# 解压出来的源码副本可由 05-代码包 内的 zip 重建
/deliverables/06-可运行包/chronoguard_ts-*/
/research_system_20261007/runs/
/research_system_20261007/logs/
/research_system_20261007/assets/word_qa/
/research_system_20261007/assets/*audit.json
/research_system_20261007/assets/docx_conversion_diagnostics.json

